# Copy to .env and fill in. NEVER commit .env.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key for the backend writer (bypasses RLS). Keep it secret.
SUPABASE_KEY=your-service-role-key





# Optional: direct Postgres connection (for psql / SQLAlchemy if needed)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Scraper behaviour ---
SCRAPE_HEADLESS=true
SCRAPE_MIN_DELAY=2          # min seconds between requests (be polite)
SCRAPE_MAX_DELAY=6          # max seconds between requests
SCRAPE_MAX_PAGES=20         # safety cap on pagination per search
# SCRAPE_UA=                # optional override of the browser user-agent

# --- Proxy (optional; leave blank until IPs get blocked) ---
# e.g. PROXY_SERVER=http://gateway.example.com:8000
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Valuation (Phase 2 — keep configurable) ---
YIELD_MIN=0.05
YIELD_MAX=0.08
YIELD_DEFAULT=0.065
